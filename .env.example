# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any Gemini model id. "gemini-flash-latest" always points at the newest Flash model.
GEMINI_MODEL=gemini-flash-latest

# Country the advisor focuses on (schemes, currency, regulations)
ADVISOR_COUNTRY=India

# SQLite file location (created automatically)
DB_PATH=data/advisor.db

# How long identical research answers are reused from the local cache (hours, 0 = off)
CACHE_HOURS=6

# Sarvam AI - fallback LLM used when Gemini fails (quota, overload, network). https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
